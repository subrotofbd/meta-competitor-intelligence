# ============================================================
# Brandset Meta Competitor Intelligence
# .env.example  -- TEMPLATE ONLY. SAFE PLACEHOLDERS.
#
# Copy to .env and fill in real values locally:
#     Copy-Item .env.example .env
#
# .env is gitignored. NEVER commit real credentials.
# Every variable below is documented in the project docs.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=Brandset Meta Competitor Intelligence
APP_ENV=local                  # local | dev | test | prod
APP_DEBUG=false
# Comma-separated origins. Local frontend is Vite on 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Structured logging. run_id is injected per collection run in S1.
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | text

# ------------------------------------------------------------
# Database (PostgreSQL 16)
# Primary runtime path: Docker Desktop + docker compose.
# Host/port below match the docker compose service definition.
#
# NOTE: psycopg (v3) URL format is REQUIRED, not psycopg2.
DATABASE_URL=postgresql+psycopg://brandset:CHANGE_ME@localhost:5432/brandset
DATABASE_ECHO=false

# Used by Alembic and by tests that need a throwaway database.
# TEST_DATABASE_URL=postgresql+psycopg://brandset:CHANGE_ME@localhost:5432/brandset_test

# ------------------------------------------------------------
# Job queue
# Postgres-backed job queue in slice 1, behind a JobQueue Protocol.
# The queue implementation must stay replaceable -- do not make the
# architecture permanently dependent on PostgreSQL as the queue.
JOB_QUEUE_BACKEND=postgres      # postgres | (future backends)
JOB_POLL_INTERVAL_SECONDS=5
JOB_MAX_ATTEMPTS=3
JOB_LOCK_TIMEOUT_SECONDS=300

# ------------------------------------------------------------
# Ad data providers
#
# DATA ACCESS RULES (strict, non-negotiable):
#   - No CAPTCHA bypass
#   - No authentication bypass
#   - No anti-bot bypass
#   - No proxy rotation for evasion
#   - No TLS/header fingerprint impersonation
#   - No lsd token mining
#   - No reverse-engineered internal GraphQL / doc IDs
#   - No private endpoints
#   - No rate-limit circumvention
# A blocked provider MUST stop the run and report the block.
#
# Only MockProvider ships in S0-S3. Real providers arrive after S3
# and are gated on the data-access decisions in DATA_ACCESS.md.
# ------------------------------------------------------------
PROVIDER_DEFAULT=mock           # mock only for S0-S3
PROVIDER_MOCK_FIXTURES_DIR=tests/fixtures
PROVIDER_REQUEST_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=3

# Meta official Ad Library API (EU/UK + political/issue only).
# NOT on the India critical path. Left unset by design.
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=

# Third-party providers (optional, off by default, not in S0-S3).
# APIFY_API_TOKEN=

# ------------------------------------------------------------
# Media store
# No media byte downloads in S0-S3. Interface seam only.
# Content-addressed keys. Media is served through authenticated
# backend routes, never a public bucket.
# MEDIA_STORE_BACKEND=local
# MEDIA_LOCAL_ROOT=./storage
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# ------------------------------------------------------------
# AI provider
# Interface seam only in S0. Copy analysis lands in S3.
# Model names come from settings and are NEVER hard-coded.
# No AI SDK is installed yet.
# ------------------------------------------------------------
# AI_PROVIDER=mock
# AI_MODEL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# GEMINI_API_KEY=
# AI_MAX_ANALYSES_PER_RUN=50
# AI_ANALYSIS_VERSION=1

# ------------------------------------------------------------
# Authentication -- FUTURE SEAM ONLY
# No login UI in S0-S3. These are placeholders for a later phase.
# Passwords: Argon2. Short-lived access token + refresh.
# ------------------------------------------------------------
# AUTH_ENABLED=false
# JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# Caching / rate limiting
# ------------------------------------------------------------
# RATE_LIMIT_REQUESTS_PER_MINUTE=120
