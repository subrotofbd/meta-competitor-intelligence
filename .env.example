# ============================================================
# Brandset Meta Competitor Intelligence
# .env.example  -- TEMPLATE ONLY. SAFE PLACEHOLDERS.
#
# Copy to .env and fill in real values locally:
#     Copy-Item .env.example .env
#
# .env is gitignored. NEVER commit real credentials.
#
# This file lists only the variables checkpoint S0.2 actually
# introduces. Settings for providers, AI, media, auth and the job
# queue are added by the checkpoint that implements them, not
# before -- an unused variable in here is a promise the code does
# not keep.
#
# Every variable below is read either by app.core.config.Settings
# (the backend, the worker, Alembic, and the tests) or by
# docker compose.
# ============================================================

# ------------------------------------------------------------
# Application
#
# local | dev | test | prod
#
# app_env=prod additionally REFUSES to start with log_level=DEBUG
# or database_echo=true, because both write credentials into the
# log stream. The check is a startup error, not a warning.
# ------------------------------------------------------------
APP_ENV=local

# ------------------------------------------------------------
# Logging
#
# JSON: one object per line, so a single collection run can be
# followed by run_id across the API and the worker.
# text: one readable line, for a terminal.
#
# run_id is NOT configured here. It is bound per run at runtime by
# app.core.logging.run_id_context.
# ------------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                # json | text

# ------------------------------------------------------------
# Database -- PostgreSQL 16, in Docker
#
# The URL must be psycopg 3: it has to start with
# postgresql+psycopg://. A bare postgresql:// URL is rejected at
# startup rather than failing later with a confusing driver error.
#
# The URL embeds a password, so it is held as a SecretStr. It will
# not appear in a log line, an error message, or a traceback.
#
# These values must match the POSTGRES_* block below: same user,
# password, port and database. Compose uses POSTGRES_* to build the
# container; the backend and Alembic connect with DATABASE_URL.
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://brandset:CHANGE_ME@localhost:5432/brandset

# Logs every SQL statement AND its bound parameters. Useful locally,
# a credential leak in production -- blocked when APP_ENV=prod.
DATABASE_ECHO=false

# ------------------------------------------------------------
# Collection safety -- operational bounds, not product policy
#
# Neither of these says anything about how many ads a competitor
# "should" be running. There is no such number in the product, and
# putting one in a config file would be a business claim dressed
# as a setting. They exist because two things go wrong without
# them, and both end with data we cannot get back: a provider
# looping forever, and a worker holding every response at once.
# ------------------------------------------------------------

# The most records one collection run reads into memory before it
# stops walking. A run that hits it is `partial` and every response
# it already stored is kept -- the limit bounds a run, not what a
# provider may serve, and a single page larger than this is still
# stored and still read. Raise it for a very large page; lower it
# to cap worker memory.
COLLECTION_MAX_RECORDS_PER_RUN=10000

# How long a `running` collection run may show no sign of progress
# before it is treated as abandoned and marked `failed`, which
# hands the page back to the scheduler. A run is only eligible
# when it is `running`, has no job holding a live lease, AND has
# added no provider call in this long -- so all three must agree.
#
# Must comfortably exceed the job lease (5 minutes, not yet
# configurable) or every legitimately long run would look dead.
# A value at or under the lease is refused at startup.
#
# ISO-8601 duration: P, meaning a fixed period. PT30M is 30 minutes.
# A bare number is NOT accepted here and will fail to parse.
#
# Recovery never marks a run `complete`; only time has passed, and
# that is not evidence that any work was finished.
COLLECTION_STALE_RUN_TIMEOUT=PT30M

# ------------------------------------------------------------
# Consumed by docker compose to initialise the container.
#
# POSTGRES_PASSWORD deliberately has no default: if it is unset,
# compose refuses to start rather than falling back to a
# guessable password.
#
# POSTGRES_PORT is the HOST port. Change it if 5432 is already in
# use, and change the port inside DATABASE_URL to match.
# ------------------------------------------------------------
POSTGRES_USER=brandset
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING
POSTGRES_DB=brandset
POSTGRES_PORT=5432
