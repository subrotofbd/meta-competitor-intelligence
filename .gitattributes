# Brandset Meta Competitor Intelligence
# Line-ending and file-mode policy.
#
# The project path contains a space and development happens on Windows
# against Linux containers. Without this, git rewrites LF -> CRLF in the
# working tree and produces whole-file diffs. See SETUP_WINDOWS.md 12.

# Normalise text files in the repository to LF.
* text=auto eol=lf

# Files git must treat as binary (never line-ending converted).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.mp4   binary
*.mov   binary
*.woff  binary
*.woff2 binary

# Windows scripts: CRLF is correct for .cmd/.bat/.ps1
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts must stay LF or they break in the Linux containers.
*.sh   text eol=lf

# Lockfiles and config that must never be rewritten.
uv.lock       text eol=lf
pyproject.toml text eol=lf
*.md          text eol=lf
